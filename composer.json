{
  "name": "ez-php/i18n",
  "version": "1.8.0",
  "description": "Internationalisation module for the ez-php framework — file-based translations with dot-notation keys and locale fallback",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["i18n", "internationalization", "translation", "localisation", "php", "framework", "ez-php"],
  "homepage": "https://github.com/ez-php/i18n",
  "support": {
    "issues": "https://github.com/ez-php/i18n/issues",
    "source": "https://github.com/ez-php/i18n"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^1.0"
  },
  "require-dev": {
    "ez-php/docker": "^1.0",
    "ez-php/testing-application": "^1.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\I18n\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
